# Oracle Cloud Always Free deployment env — copy to .env in deploy/ and fill in.
#   cp .env.example.oracle .env
#
# DOMAIN is required for HTTPS. Two options (see oracle-setup.md §4):
#   A) free subdomain: DOMAIN=finlens.duckdns.org   (DuckDNS, free, no purchase)
#   B) your own domain: DOMAIN=finlens.example.com
# Quick test without a domain: DOMAIN=http://<public-ip> (plain HTTP).

DOMAIN=finlens.duckdns.org

# Optional tuning
# MODEL_NAME=Qwen/Qwen2.5-1.5B
# MAX_TOKENS=1024
# TEMP=0.4